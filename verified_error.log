   528      def _get_abs_corr_mat(self, X_filled, tolerance=1e-6):
   529          """Get absolute correlation matrix between features.
   530  
   531          Parameters
   532          ----------
   533          X_filled : ndarray, shape (n_samples, n_features)
   534              Input data with the most recent imputations.
   535  
   536          tolerance : float, default=1e-6
   537              `abs_corr_mat` can have nans, which will be replaced
   538              with `tolerance`.
   539  
   540          Returns
   541          -------
   542          abs_corr_mat : ndarray, shape (n_features, n_features)
   543              Absolute correlation matrix of `X` at the beginning of the
   544              current round. The diagonal has been zeroed out and each feature's
   545              absolute correlations with all others have been normalized to sum
   546              to 1.
   547          """
   548          n_features = X_filled.shape[1]
   549          if self.n_nearest_features is None or self.n_nearest_features >= n_features:
   550              return None
   551          with np.errstate(invalid="ignore"):
   552              # if a feature in the neighborhood has only a single value
   553              # (e.g., categorical feature), the std. dev. will be null and
   554              # np.corrcoef will raise a warning due to a division by zero
   555              abs_corr_mat = np.abs(np.corrcoef(X_filled.T))
   556          # np.corrcoef is not defined for features with zero std
   557          abs_corr_mat[np.isnan(abs_corr_mat)] = tolerance
   558          # ensures exploration, i.e. at least some probability of sampling
   559          np.clip(abs_corr_mat, tolerance, None, out=abs_corr_mat)
   560          # features are not their own neighbors
   561          np.fill_diagonal(abs_corr_mat, 0)
   562          # needs to sum to 1 for np.random.choice sampling
   563          abs_corr_mat = normalize(abs_corr_mat, norm="l1", axis=0, copy=False)
   564          return abs_corr_mat
